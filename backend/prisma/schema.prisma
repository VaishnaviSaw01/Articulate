generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Problem {
  id           String    @id @default(uuid())
  slug         String    @unique
  title        String
  category     String
  difficulty   String
  prompt       String
  constraints  String?
  examples     Json
  starterCode  Json
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

enum SessionStatus {
  DRAFT
  TRANSCRIBING
  SCORING
  COMPLETED
  FAILED
}

model Session {
  id          String        @id @default(uuid())
  userId      String
  problemId   String
  language    String
  code        String
  audioPath   String?
  transcript  String?
  segments    Json?
  status      SessionStatus @default(DRAFT)
  isSeed      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem          Problem            @relation(fields: [problemId], references: [id])
  codeScore        CodeScore?
  communicationScore CommunicationScore?
  transcriptMetrics  TranscriptMetrics?
}

model CodeScore {
  id             String   @id @default(uuid())
  sessionId      String   @unique
  overall        Int
  correctness    Int
  timeComplexity String
  spaceComplexity String
  edgeCaseCoverage Int
  codeQuality    Int
  rationale      String
  raw            Json
  createdAt      DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model CommunicationScore {
  id           String   @id @default(uuid())
  sessionId    String   @unique
  overall      Int
  structure    Int
  clarity      Int
  confidence   Int
  completeness Int
  pacing       Int
  tips         Json
  raw          Json
  createdAt    DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model TranscriptMetrics {
  id              String   @id @default(uuid())
  sessionId       String   @unique
  wordCount       Int
  durationSec     Float
  wordsPerMinute  Float
  fillerCount     Int
  fillerBreakdown Json
  longestPauseMs  Float?
  createdAt       DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
