# PostgreSQL connection string (see docker-compose.yml for local defaults)
DATABASE_URL="postgresql://articulate:articulate@localhost:5432/articulate?schema=public"

# Anthropic API key — required for both code-correctness and communication scoring
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# JWT signing secret — change this in any real deployment
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="7d"

# Local speech-to-text microservice (faster-whisper), see stt-service/
STT_SERVICE_URL="http://localhost:8001"

PORT=4000
CORS_ORIGIN="http://localhost:5173"
